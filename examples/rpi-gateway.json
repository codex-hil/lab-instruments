{
  "mode": "usb-gateway",
  "listen": [
    "192.168.50.2",
    8840
  ],
  "token_file": "/etc/labinst/access.token",
  "tls": {
    "cert": "/etc/labinst/server.crt",
    "key": "/etc/labinst/server.key"
  },
  "slots": {
    "usb1": {
      "topology": "REPLACE_WITH_USB_TOPOLOGY_1",
      "timeout": 4,
      "delay": 0.05
    },
    "usb2": {
      "topology": "REPLACE_WITH_USB_TOPOLOGY_2",
      "timeout": 4,
      "delay": 0.05
    },
    "usb3": {
      "topology": "REPLACE_WITH_USB_TOPOLOGY_3",
      "timeout": 4,
      "delay": 0.05
    },
    "usb4": {
      "topology": "REPLACE_WITH_USB_TOPOLOGY_4",
      "timeout": 4,
      "delay": 0.05
    }
  }
}
