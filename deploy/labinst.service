[Unit]
Description=Lab instrument control or USB gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=labinst
Group=labinst
WorkingDirectory=/opt/labinst
ExecStart=/usr/bin/python3 /opt/labinst/labinst.pyz serve --config /etc/labinst/config.json
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
UMask=0077
# USB nodes stay visible; access requires an explicit per-device udev rule.

[Install]
WantedBy=multi-user.target
